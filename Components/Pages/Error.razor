@page "/Error"

<PageTitle>Error | Ziur</PageTitle>

<main class="page-shell">
    <section class="status-card error-card" role="alert">
        <span class="status-icon">!</span>
        <div class="status-content">
            <strong>Ocurrió un error inesperado</strong>
            <p>La solicitud no pudo completarse. Inténtalo de nuevo.</p>
            <a class="btn btn-secondary" href="/">Volver al inicio</a>
        </div>
    </section>
</main>
